<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is ONLY for Google Play In-App Updates / Play services (update check + Play-managed install).
         It is NOT for app networking: the WebView is served by WebViewAssetLoader, CSP is connect-src 'none',
         and navigation off the asset host is blocked. No REQUEST_INSTALL_PACKAGES, no storage permission (SAF only). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Spcc"
        android:supportsRtl="true"
        android:theme="@style/Theme.PassToCsv">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
